# ==============================================================================
# ComicVerse Web Environment Variables Template (Local)
# ==============================================================================

# API Gateway Endpoint (All requests route via Gateway port 8080)
VITE_API_URL=http://localhost:8080

# Environment Label: local | dev | staging | production
VITE_APP_ENV=local

# Application Title
VITE_APP_NAME=ComicVerse Local Reader

# Feature Flags
VITE_AUTH_ENABLED=true
VITE_ENABLE_ANALYTICS=false
