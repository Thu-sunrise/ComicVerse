# ============================================================
# ComicVerse — Root Environment Variables Template
#
# INSTRUCTIONS:
#   cp .env.example .env
#   Fill in all <placeholder> values before starting services.
#   NEVER commit the .env file.
# ============================================================

# ============================================================
# APPLICATION ENVIRONMENT
# ============================================================
APP_ENV=dev
APP_VERSION=0.0.1-SNAPSHOT

# ============================================================
# API GATEWAY
# ============================================================
GATEWAY_PORT=8080
GATEWAY_SECRET=change-me-in-production-use-strong-random-string

# Service URLs (internal Docker network names)
AUTH_SERVICE_URL=http://auth-service:8081
STORY_SERVICE_URL=http://story-service:8082
SYNC_SERVICE_URL=http://sync-service:8083
USER_SERVICE_URL=http://user-service:8084
PAYMENT_SERVICE_URL=http://payment-service:8085
RECOMMENDATION_SERVICE_URL=http://recommendation-service:8086
CHAT_SERVICE_URL=http://chat-service:8087
NOTIFICATION_SERVICE_URL=http://notification-service:8088
SEARCH_SERVICE_URL=http://search-service:8089
MEDIA_SERVICE_URL=http://media-service:8090

# ============================================================
# CORS
# ============================================================
# Comma-separated list of allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ============================================================
# JWT — RSA Asymmetric Signing
# Generate keys: ./scripts/generate-jwt-keys.sh
# ============================================================
# Base64-encoded RSA private key PEM (auth-service ONLY)
JWT_PRIVATE_KEY_BASE64=<base64-encoded-rsa-private-key-pem>
# Base64-encoded RSA public key PEM (gateway + all services)
JWT_PUBLIC_KEY_BASE64=<base64-encoded-rsa-public-key-pem>

JWT_ISSUER=comicverse-auth
JWT_ACCESS_TOKEN_EXPIRY_SECONDS=900
JWT_REFRESH_TOKEN_EXPIRY_SECONDS=2592000

# ============================================================
# DATABASES — Neon PostgreSQL (one per domain service)
# Create 10 separate databases in Neon.
# Run: ./scripts/setup-neon.md for creation instructions.
# Run: ./scripts/migrate-all.sh after filling these in.
# ============================================================

AUTH_DATABASE_URL=jdbc:postgresql://<neon-auth-endpoint>/auth_db?sslmode=require
AUTH_DATABASE_USERNAME=<neon-auth-username>
AUTH_DATABASE_PASSWORD=<neon-auth-password>

STORY_DATABASE_URL=jdbc:postgresql://<neon-story-endpoint>/story_db?sslmode=require
STORY_DATABASE_USERNAME=<neon-story-username>
STORY_DATABASE_PASSWORD=<neon-story-password>

SYNC_DATABASE_URL=jdbc:postgresql://<neon-sync-endpoint>/sync_db?sslmode=require
SYNC_DATABASE_USERNAME=<neon-sync-username>
SYNC_DATABASE_PASSWORD=<neon-sync-password>

USER_DATABASE_URL=jdbc:postgresql://<neon-user-endpoint>/user_db?sslmode=require
USER_DATABASE_USERNAME=<neon-user-username>
USER_DATABASE_PASSWORD=<neon-user-password>

PAYMENT_DATABASE_URL=jdbc:postgresql://<neon-payment-endpoint>/payment_db?sslmode=require
PAYMENT_DATABASE_USERNAME=<neon-payment-username>
PAYMENT_DATABASE_PASSWORD=<neon-payment-password>

RECOMMENDATION_DATABASE_URL=jdbc:postgresql://<neon-recommendation-endpoint>/recommendation_db?sslmode=require
RECOMMENDATION_DATABASE_USERNAME=<neon-recommendation-username>
RECOMMENDATION_DATABASE_PASSWORD=<neon-recommendation-password>

CHAT_DATABASE_URL=jdbc:postgresql://<neon-chat-endpoint>/chat_db?sslmode=require
CHAT_DATABASE_USERNAME=<neon-chat-username>
CHAT_DATABASE_PASSWORD=<neon-chat-password>

NOTIFICATION_DATABASE_URL=jdbc:postgresql://<neon-notification-endpoint>/notification_db?sslmode=require
NOTIFICATION_DATABASE_USERNAME=<neon-notification-username>
NOTIFICATION_DATABASE_PASSWORD=<neon-notification-password>

SEARCH_DATABASE_URL=jdbc:postgresql://<neon-search-endpoint>/search_db?sslmode=require
SEARCH_DATABASE_USERNAME=<neon-search-username>
SEARCH_DATABASE_PASSWORD=<neon-search-password>

MEDIA_DATABASE_URL=jdbc:postgresql://<neon-media-endpoint>/media_db?sslmode=require
MEDIA_DATABASE_USERNAME=<neon-media-username>
MEDIA_DATABASE_PASSWORD=<neon-media-password>

# ============================================================
# RABBITMQ — Message Broker
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=comicverse
RABBITMQ_PASSWORD=change-me-rabbitmq-password
RABBITMQ_VHOST=/

# Management UI (DEV only, exposed on host port 15672)
RABBITMQ_MANAGEMENT_PORT=15672

# ============================================================
# ABLY — Realtime Transport
# NEVER expose ABLY_API_KEY to frontend.
# Frontend obtains a token from: GET /api/v1/realtime/token
# ============================================================
ABLY_API_KEY=<your-ably-api-key>

# ============================================================
# FCM — Firebase Cloud Messaging (Push Notifications)
# ============================================================
# Path to Firebase service account JSON file (mounted into container)
FCM_SERVICE_ACCOUNT_PATH=/run/secrets/fcm-service-account.json
# OR base64-encoded JSON string (alternative to file path)
FCM_SERVICE_ACCOUNT_JSON_BASE64=<base64-encoded-service-account-json>

# ============================================================
# NGINX
# ============================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# ============================================================
# FRONTEND
# ============================================================
# web-reader (points to Gateway only)
VITE_API_URL=http://localhost:8080
# web-admin (points to Gateway only)
VITE_ADMIN_API_URL=http://localhost:8080
